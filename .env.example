# ===== DATABASE =====
DATABASE_URL=postgresql+asyncpg://opensaas:password@localhost:5432/opensaas_db

# Используются только в docker-compose.yml (локальный контейнер postgres)
POSTGRES_DB=opensaas_db
POSTGRES_USER=opensaas
POSTGRES_PASSWORD=password

# ===== REDIS (опционально) =====
# Если не задан — используется PostgreSQL fallback
# Для включения раскомментировать:
# REDIS_URL=redis://localhost:6379

# ===== JWT =====
SECRET_KEY=your-secret-key-minimum-32-characters-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ===== ADMIN (создаётся при первом запуске) =====
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_in_production

# ===== SMTP EMAIL =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=OpenSaaS
SMTP_USE_TLS=true

# ===== РОБОКАССА =====
ROBOKASSA_MERCHANT_LOGIN=your_merchant_login
ROBOKASSA_PASSWORD1=your_password1
ROBOKASSA_PASSWORD2=your_password2
ROBOKASSA_TEST_MODE=false

# ===== AI GATEWAY (чат с ИИ) =====
# OpenAI-совместимый шлюз. Ключ: панель Timeweb → AI Gateway.
AI_GATEWAY_URL=https://api.timeweb.ai/v1
AI_GATEWAY_KEY=
# Наценка к себестоимости токенов, %. Цены моделей — в админке «Модели ИИ».
AI_MARKUP_PERCENT=25
AI_DEFAULT_MODEL=openai/gpt-5.4-mini
# Сколько последних сообщений чата отправлять модели и потолок длины ответа.
AI_CONTEXT_MESSAGES=30
AI_MAX_OUTPUT_TOKENS=8000

# ===== STRIPE (заготовка, не активен) =====
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here
STRIPE_ENABLED=false

# ===== APP =====
APP_NAME=OpenSaaS
# Адрес сайта для ссылок в письмах. Если пусто, берётся из заголовка Host запроса.
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# ===== БИЗНЕС ЛОГИКА =====
# Процент рефереру с каждого пополнения (наценка на ИИ 25% — не ставьте больше 10).
REFERRAL_COMMISSION_PERCENT=5
# Бонус на баланс при регистрации, ₽ (0 = без бонуса).
WELCOME_BONUS=0
TOPUP_MIN_AMOUNT=100
TOPUP_MAX_AMOUNT=100000


# ===== LOCAL DOCKER =====
# DATABASE_URL уже переопределён в docker-compose.local.yml
# Менять не нужно
